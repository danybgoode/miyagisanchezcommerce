# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
env.vercel-migration

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reference material (screenshots, design-system exports, scratch notes)
/references

# playwright e2e artifacts
/test-results
/playwright-report
/playwright/.cache

# clerk configuration (can include secrets)
/.clerk/

# git worktrees cut for feature/fix branches (own checkouts, not repo content)
/.worktrees/

# codex CLI local config (cross-agent review tool, machine-local)
/.codex/

# Supabase CLI update-check cache. Rewritten whenever the CLI checks for a new
# release, so a tracked copy shows up as a dirty tree in every worktree forever —
# it was flagged as an anomaly in three consecutive session-resume runs. The rest
# of supabase/.temp/ stays TRACKED on purpose: project-ref and linked-project.json
# are what tell the CLI which project this repo is linked to, and the CLI is the
# migration mechanism here (AGENTS.md §6).
supabase/.temp/cli-latest
